# Copy to .env (git-ignored) only if you need to override defaults. No secrets are required for local use.

# SQLAlchemy URL. Default: local SQLite file in backend/
# DATABASE_URL=sqlite:///./fraudshield.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Directory containing pipeline.joblib, feature_schema.json, threshold.json
# FRAUDSHIELD_MODEL_DIR=ml/artifacts/model_v1

# Comma-separated list of allowed browser origins for CORS
# CORS_ALLOWED_ORIGINS=http://localhost:5173
