# Backend environment variables. Copy to backend/.env (git-ignored) only if you need them locally; in production set
# them in the Render dashboard (Environment tab). Never commit real values, and never use a VITE_ variable for a
# secret: anything prefixed VITE_ is shipped to every browser.

# --- AI analyst (Google Gemini, server-side only) --- see docs/AI_ANALYST.md
# Off unless exactly "true".
GEMINI_ANALYST_ENABLED=false
# Secret. Leave empty here; set it only in the hosting platform's secret settings.
GEMINI_API_KEY=
# A currently supported Gemini Flash model (checked against Google's model list on 2026-10-29).
GEMINI_MODEL=gemini-3.8-flash
# Whole-request time limit in seconds (3-60). One attempt only; there are no automatic retries.
GEMINI_TIMEOUT_SECONDS=25
# Output budget per explanation (512-8192 tokens, including the model's thinking).
GEMINI_MAX_OUTPUT_TOKENS=4096
# minimal | low | medium | high; empty sends no thinking setting.
GEMINI_THINKING_LEVEL=low
# synthetic_only (default): only the server-configured synthetic demo ledger is ever sent to Gemini.
# allow_non_synthetic: also send other data. Only set this with a paid-tier/data-processing agreement that permits it.
GEMINI_PRIVACY_POLICY=synthetic_only

# --- Other settings (defaults shown) ---
# ENVIRONMENT=development
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# FRAUDSHIELD_V2_DATABASE_URL=sqlite:///data/v2_fraudshield.db
